                    cardId.className = 'booking-card';

                    const cardIdBody = document.createElement('div');
                    cardIdBody.className = 'card-body';

                    const bookingIdDetails = document.createElement('div');
                    bookingIdDetails.className = 'booking-details';

                    const headday = document.createElement('div');
                    headday.style = "text-align: center;";
                    headday.textContent = `หมายเลขการจอง : ${booking[`id`]}`;

                    bookingIdDetails.appendChild(headday);

                    cardIdBody.appendChild(bookingIdDetails);

                    cardId.appendChild(cardIdBody);
                    document.body.appendChild(cardId);

                    const card = document.createElement('div');
                    card.className = 'booking-card slide-from-top';
                    card.id = `${booking[`id`]}`;
                    card.style = "margin-top: -7px;";


                    cardId.addEventListener('click', function () {

                        if (document.getElementById(`${booking[`id`]}`).getAttribute("class").includes("active")) {
                            document.getElementById(`${booking[`id`]}`).classList.remove('active');
                        } else {
                            document.getElementById(`${booking[`id`]}`).classList.add('active');
                        }

                    });

                    const cardBody = document.createElement('div');
                    cardBody.className = 'card-body';

                    const bookingDetails = document.createElement('div');
                    bookingDetails.className = 'booking-details';

                    const detailDiv = document.createElement('div');
                    detailDiv.style = "display: flex;width: 100%;flex-direction: column;";

                    const detailday = document.createElement('div');
                    detailday.textContent = `วัน : ${booking[`day`]}`;
                    const detailbound = document.createElement('div');
                    detailbound.textContent = `ขา : ${booking[`bound`]}`;
                    const detailtime = document.createElement('div');
                    detailtime.textContent = `เวลา : ${booking[`time`]}`;
                    const detailroute = document.createElement('div');
                    detailroute.textContent = `สาย : ${booking[`route`]}`;
                    const detailpoint = document.createElement('div');
                    detailpoint.textContent = `จุดขึ้น : ${booking[`point`]}`;
                    const detailstatus = document.createElement('div');
                    detailstatus.textContent = `สถานะ : ${booking[`status`]}`;

                    detailDiv.appendChild(detailday)
                    detailDiv.appendChild(detailbound)
                    detailDiv.appendChild(detailtime)
                    detailDiv.appendChild(detailroute)
                    detailDiv.appendChild(detailpoint)
                    detailDiv.appendChild(detailstatus)

                    bookingDetails.appendChild(detailDiv);
                    cardBody.appendChild(bookingDetails);
                    card.appendChild(cardBody);
                    document.body.appendChild(card);
                }

