            const divbutton = document.createElement('div');
            divbutton.style = "display: flex; justify-content: space-between;width: 300px;";

            const BookButton = document.createElement('button');
            BookButton.type = 'edit';
            BookButton.textContent = 'จองรถ';

            BookButton.addEventListener('click', function () {

                const first3Children = Array.from(document.body.children).slice(0, 3);

                document.body.innerHTML = "";

                first3Children.forEach(child => document.body.appendChild(child));

                createBookingform(data);

            });

            divbutton.appendChild(BookButton);

            if (data.bookingnextweek.length != 0) {

                const cancleButton = document.createElement('button');
                cancleButton.type = 'edit';
                cancleButton.textContent = 'ยกเลิกจอง';

