<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>This week Summary</title>
    <link href="/css/thisweekdashboard.css" rel="stylesheet" type="text/css">
</head>

<body>
    <div class="container">
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <!--<img src="/path/to/logo.png" alt="Company Logo"> -->
                </div>
                <ul class="menu">
                    <li><a href="/member">Member</a></li>
                    <li ><a href="/thisweekdashboard">Thisweek</a></li>
                    <li class="active"><a href="/nextweekdashboard">Nextweek</a></li>
                    <li><a href="/sumthisweek">Sumthisweek</a></li>
                    <li><a href="/bustoday">Bus</a></li>
                    <li><a href="/seattoday">Seat</a></li>
                    <li><a href="/bushistory">Bus History</a></li>
          <li><a href="/seathistory">Seat History</a></li>
                </ul>
            </div>
            <div class="footer">
                <div class="company-info">
                    <p>Resonac</p>
                    <p>CHP</p>
                </div>
                <a href="/logout" style="display:block;margin-top:12px;padding:8px 12px;background:#ef4444;color:#fff;text-decoration:none;border-radius:6px;font-size:13px;text-align:center;">ออกจากระบบ</a>
            </div>
        </nav>
        <main class="main-content">
            <header class="header">
                <div class="user-info">
                    <!-- <img src="/path/to/user-avatar.png" alt="User Avatar"> -->
                    <span>CHP Shuttle Bus</span>
                </div>
                <div class="actions">
                </div>
            </header>
            <section class="filter-bar">
                <input type="text" placeholder="เลขประจำตัว">
                <input type="text" placeholder="ชื่อ">
               
                <button class="apply-btn">ค้นหา</button>
            </section>
            <section class="table-section">
                <table class="approval-table">
                    <thead>
                        <tr>
                            <th>ลำดับ</th>
                            <th>หมายเลขประจำตัว</th>
                            <th>ชื่อ</th>
                            <th>นามสกุล</th>
                            <th>จุดขึ้นรถ</th>
                            <th>🟡 เข้า</th>
                            <th>🟡 ออก</th>
                            <th>🌸 เข้า</th>
                            <th>🌸 ออก</th>
                            <th>🟢 เข้า</th>
                            <th>🟢 ออก</th>
                            <th>🟠 เข้า</th>
                            <th>🟠 ออก</th>
                            <th>🔵 เข้า</th>
                            <th>🔵 ออก</th>
                            <th>🟣 เข้า</th>
                            <th>🟣 ออก</th>
                            <th>🔴 เข้า</th>
                            <th>🔴 ออก</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% rows.forEach((row, index)=> { %>
                            <tr data-userid="<%= row.userid %>">
                                <td>
                                    <%= index + 1 %>
                                </td>
                                <td>
                                    <%= row.perid %>
                                </td>
                                <td>
                                    <%= row.first_name %>
                                </td>
                                <td>
                                    <%= row.last_name %>
                                </td>
                                <td>
                                    <%= row.location %>
                                </td>
                                <td>
                                    <% if (row.monday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.monday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.monday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.monday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.tuesday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.tuesday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.tuesday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.tuesday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.wednesday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.wednesday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.wednesday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.wednesday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.thursday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.thursday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.thursday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.thursday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.friday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.friday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.friday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.friday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.saturday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.saturday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.saturday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.saturday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.sunday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.sunday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.sunday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.sunday_outbound %>
                                                <% } %>
                                </td>
                                
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
                <div class="footer-table">
                    <div class="pagination">
                        <button class="prev-page">&lt;</button>
                        <span>1/10 Pages</span>
                        <button class="next-page">&gt;</button>
                    </div>
                    <div class="results">
                        <span>1 result(s)</span>
                    </div>

                </div>

            </section>
        </main>
    </div>
    <script src="/js/dashboard.js"></script>
</body>

</html>