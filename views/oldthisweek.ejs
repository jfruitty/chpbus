    <script>

        function runApp() {
            const idToken = liff.getIDToken();
            const accessToken = liff.getAccessToken()


            liff.getProfile().then(profile => {


                console.log('Response:', profile);
                console.log('accessToken:', accessToken);



                fetch(`/getuserdata?accesstoken=${accessToken}&page=thisweek`)
                    .then(response => response.json())
                    .then(data => {

                        console.log(data)

                        document.getElementById('loader').style.display = 'none';
                        document.getElementById('loading-text').style.display = 'none';

                        if (data.userData.approve == 'approved') {

                            if (data.bookthisweekData.route == '') {  // todo

                                createBookingForm(data.bookthisweekData, accessToken)

                            } else {

                                createBookingthisweekCard(data, accessToken)

                            }


                        } else if (data.userData.approve == 'standby') {

                            var status = 'รอแอดมินยืนยัน';

                            createProfileCard(profile.pictureUrl, profile.displayName, status);

                        } else {

                            var status = 'กรุณาลงทะเบียน';

                            createProfileCard(profile.pictureUrl, profile.displayName, status);



                        }
                    }).catch(err => console.error(err));
            }).catch(err => console.error(err));


        }



        liff.init({ liffId: '<%= liffid %>' }, () => {
            if (liff.isLoggedIn()) {

                runApp()
            } else {
                liff.login();
            }
        }).catch((err) => {
            console.log(err.code, err.message);
        });


        function createProfileCard(profilepic, name, status) {

            const card = document.createElement('div');
            card.className = 'card';

            const cardBody = document.createElement('div');
            cardBody.className = 'card-body';

            const profilePictureContainer = document.createElement('div');

            const profilePicture = document.createElement('img');
            profilePicture.src = profilepic;
            profilePicture.alt = 'Profile Picture';

            profilePictureContainer.appendChild(profilePicture);

            const cardText = document.createElement('div');
            cardText.className = 'card-text';

            const nameParagraph = document.createElement('p');
            nameParagraph.textContent = 'ชื่อ: ' + name;


            const statusParagraph = document.createElement('p');
            statusParagraph.textContent = 'สถานะ: ' + status;

            cardText.appendChild(nameParagraph);
            cardText.appendChild(statusParagraph);

            cardBody.appendChild(profilePictureContainer);
            cardBody.appendChild(cardText);

            card.appendChild(cardBody);
            document.body.appendChild(card);
        }

