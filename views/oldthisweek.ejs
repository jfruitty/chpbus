        function isAfter2pmOnFriday() {
            const now = new Date();
            const dayOfWeek = now.getDay(); // Sunday is 0, Monday is 1, ..., Saturday is 6

            return (dayOfWeek === 5 && now.getHours() >= 14) || dayOfWeek === 0 || dayOfWeek === 6;
        }

