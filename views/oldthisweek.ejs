            const daysOfWeek = ['🟡 Monday(in)', '🟡 Monday(out)',
                '🌸 Tuesday(in)', '🌸 Tuesday(out)',
                '🟢 Wednesday(in)', '🟢 Wednesday(out)',
                '🟠 Thursday(in)', '🟠 Thursday(out)',
                '🔵 Friday(in)', '🔵 Friday(out)',
                '🟣 Saturday(in)', '🟣 Saturday(out)',
                '🔴 Sunday(in)', '🔴 Sunday(out)'];
            const timeSlots = ['08:00', '17:00', '20:00', 'ไม่ใช้'];

            const table = document.createElement('table');
            table.setAttribute('border', '1');

            const headerRow = table.insertRow();

            //headerRow.insertCell();
            let th = document.createElement('th');
            th.textContent = formattedDateRange;
            headerRow.appendChild(th);

            for (const slot of timeSlots) {
                const th = document.createElement('th');
                th.textContent = slot;
                headerRow.appendChild(th);
            }

            const now = new Date();
            const dayWeek = now.getDay();


            for (const day of daysOfWeek) {
                const index = daysOfWeek.indexOf(day);
                const row = table.insertRow();

                const now = new Date();

                if (now.getHours() > 13 && dayWeek * 2 > index) {
                    row.style.display = 'none';
                } else if (dayWeek * 2 > index + 2) {
                    row.style.display = 'none';
                }

                const dayCell = row.insertCell();
                dayCell.textContent = day;
                dayCell.style = "text-align: left;";

                for (let i = 0; i < timeSlots.length; i++) {
                    const cell = row.insertCell();

                    if (index % 2 === 0 && i === 1) {

                        continue;
                    }

                    const radio = document.createElement('input');
                    radio.type = 'radio';
                    radio.name = day.substring(3).toLowerCase();
                    radio.value = timeSlots[i];

                    if (data[day.substring(3).toLowerCase()] === timeSlots[i]) {
                        radio.checked = true;
                    }


                    cell.appendChild(radio);
                }
            }

            form.appendChild(table);

            const inputAccessToken = document.createElement('input');
            inputAccessToken.type = 'hidden';
            inputAccessToken.id = 'userAccessToken';
            inputAccessToken.name = 'userAccessToken';
            inputAccessToken.value = '';
            inputAccessToken.required = true;


            form.appendChild(inputAccessToken);

            const div = document.createElement('div');
            div.className = 'footer-button';

            form.appendChild(div);


            const submitButton = document.createElement('button');
            submitButton.type = 'submit';
            submitButton.textContent = 'Submit';

            div.appendChild(submitButton);

            document.getElementById('userAccessToken').value = accessToken;

            form.addEventListener('submit', function (event) {

                event.preventDefault();

                submitButton.disabled = true;
              
                form.submit();
                submitFormAsync()
                    .then(() => {
                      
                        submitButton.disabled = false;
                    })
                    .catch((error) => {
                
                        submitButton.disabled = false;
                    });
            });


        }



        function submitFormAsync() {
            return new Promise((resolve, reject) => {

                setTimeout(() => {
                    console.log('Form submitted successfully');
                    resolve();

                }, 10000);
            });
        }

