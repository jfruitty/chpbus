<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seat</title>
    <link href="/css/driver.css" rel="stylesheet" type="text/css">
</head>

<body>
    <div class="container">
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <!--<img src="/path/to/logo.png" alt="Company Logo"> -->
                </div>
                <ul class="menu">
                    <li><a href="/member">Member</a></li>
                    <li><a href="/thisweekdashboard">Thisweek</a></li>
                    <li><a href="/nextweekdashboard">Nextweek</a></li>
                    <li><a href="/sumthisweek">Sumthisweek</a></li>
                    <li><a href="/bustoday">Bus</a></li>
                    <li class="active"><a href="/seattoday">Seat</a></li>
                    <li><a href="/bushistory">Bus History</a></li>
                    <li><a href="/seathistory">Seat History</a></li>
                </ul>
            </div>
            <div class="footer">
                <div class="company-info">
                    <p>Resonac</p>
                    <p>CHP</p>
                </div>
                <a href="/logout" style="display:block;margin-top:12px;padding:8px 12px;background:#ef4444;color:#fff;text-decoration:none;border-radius:6px;font-size:13px;text-align:center;">ออกจากระบบ</a>
            </div>
        </nav>
        <main class="main-content">
            <header class="header">
                <div class="user-info">
                    <span>CHP Shuttle Bus</span>
                </div>
                <div class="actions">
                </div>
            </header>
            <section class="filter-bar">
                <input type="text" placeholder="สายรถ">
                <input type="text" placeholder="วัน">
                <input type="text" placeholder="ขา">
                <input type="text" placeholder="เวลา">
                <button class="add-btn">เพิ่มผู้โดยสาร</button>
                <button id="downloadCsvButton">Download File</button>
            </section>
            <section class="table-section">
                <table class="approval-table">
                    <thead>
                        <tr>
                            <th>ลำดับ</th>
                            <th>รหัสพนักงาน</th>
                            <th>ชื่อ - สกุล</th>
                            <th>สายรถ</th>
                            <th>จุดขึ้นรถ</th>
                            <th>วัน</th>
                            <th>ขา</th>
                            <th>เวลา</th>
                            <th>คันที่</th>
                            <th>ที่นั่ง</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="seatTableBody">
                        <!-- Rows will be dynamically inserted here by JavaScript -->
                    </tbody>
                </table>
                <div class="footer-table">
                    <div>
                    </div>
                    <div class="results">
                        <span>1 result(s)</span>
                    </div>

                </div>
                <div id="deleteModal" class="modal">
                    <div class="modal-content">
                        <p>กรุณายืนยันว่าต้องการลบผู้โดยสารท่านนี้ ใช่หรือไม่?</p>
                        <button id="confirm-yes">ใช่</button>
                        <button id="confirm-no">ไม่</button>
                    </div>
                </div>

                <div id="insertformModal" class="modal">
                    <div class="modal-content">
                        <span class="close">&times;</span>
                        <h2>เพิ่มผู้โดยสาร</h2>
                        <form id="paxinsertForm">
                            <div class="row">
                                <label for="perid">รหัสพนักงาน:</label>
                                <input type="text" id="perid" name="perid" style="width: 43%;">
                            </div>
                            <div class="row">
                                <label for="route">สายรถ:</label>
                                <select id="route" name="route">
                                    <option value="วัดสว่าง">วัดสว่าง</option>
                                    <option value="แคราย">แคราย</option>
                                    <option value="คลอง14">คลอง14</option>
                                    <option value="คลอง 14 (เสริม)">คลอง 14 (เสริม)</option>
                                    <option value="หมู่บ้านริมบึง">หมู่บ้านริมบึง</option>
                                    <option value="คลองเจ้า">คลองเจ้า</option>
                                    <option value="หนามแดง">หนามแดง</option>
                                    <option value="ประเวศ">ประเวศ</option>
                                    <option value="แปดริ้ว">แปดริ้ว</option>
                                    <option value="วัดเกาะ">วัดเกาะ</option>
                                    <option value="แปลงยาว">แปลงยาว</option>
                                    <option value="ลาดบัวขาว รถบัส">ลาดบัวขาว รถบัส</option>
                                    <option value="ดงน้อย">ดงน้อย</option>
                                    <option value="สนามชัย">สนามชัย</option>
                                    <option value="กรุงเทพ">กรุงเทพ</option>
                                    <option value="บางน้ำเปรี้ยว">บางน้ำเปรี้ยว</option>
                                    <option value="อื่นๆ">อื่นๆ</option>
                                </select>
                            </div>
                            <div class="row" id="other-route-row" style="display: none;">
                                <label for="otherroute">-</label>
                                <input type="text" id="otherroute" name="otherroute" style="width: 43%;">
                            </div>
                            <div class="row">
                                <label for="day">วัน:</label>
                                <select id="day" name="day">
                                    <option value="monday">จันทร์</option>
                                    <option value="tuesday">อังคาร</option>
                                    <option value="wednesday">พุธ</option>
                                    <option value="thursday">พฤหัสบดี</option>
                                    <option value="friday">ศุกร์</option>
                                    <option value="saturday">เสาร์</option>
                                    <option value="sunday">อาทิตย์</option>
                                    <!-- Add more options as needed -->
                                </select>
                            </div>
                            <div class="row">
                                <label for="bound">ขา:</label>
                                <select id="bound" name="bound">
                                    <option value="inbound">ขาเข้า</option>
                                    <option value="outbound">ขาออก</option>
                                </select>
                            </div>
                            <div class="row">
                                <label for="time">เวลา:</label>
                                <select id="time" name="time">
                                    <option value="07:30">07:30</option>
                                    <option value="08:15">08:15</option>
                                    <option value="10:30">10:30</option>
                                    <option value="17:15">17:15</option>
                                    <option value="19:30">19:30</option>
                                    <option value="20:15">20:15</option>
                                </select>
                            </div>
                            <div class="row">
                                <label for="bus_number">คันที่:</label>
                                <input type="number" id="bus_number" name="bus_number" style="width: 43%;">
                            </div>
                            <div class="row">
                                <label for="seat_number">ที่นั่ง:</label>
                                <input type="number" id="seat_number" name="seat_number" style="width: 43%;">
                            </div>
                            <button type="submit">Submit</button>
                        </form>
                    </div>
                </div>

                <!-- The Modal -->
                <div id="editformModal" class="modal">
                    <div class="modal-content">
                        <span class="close">&times;</span>
                        <h2>เปลี่ยนแปลง</h2>
                        <form id="paxEditForm">
                            <div class="row">
                                <label for="editroute">สายรถ:</label>
                                <select id="editroute" name="editroute">
                                    <option value="วัดสว่าง">วัดสว่าง</option>
                                    <option value="แคราย">แคราย</option>
                                    <option value="คลอง14">คลอง14</option>
                                    <option value="คลอง 14 (เสริม)">คลอง 14 (เสริม)</option>
                                    <option value="หมู่บ้านริมบึง">หมู่บ้านริมบึง</option>
                                    <option value="คลองเจ้า">คลองเจ้า</option>
                                    <option value="หนามแดง">หนามแดง</option>
                                    <option value="ประเวศ">ประเวศ</option>
                                    <option value="แปดริ้ว">แปดริ้ว</option>
                                    <option value="วัดเกาะ">วัดเกาะ</option>
                                    <option value="แปลงยาว">แปลงยาว</option>
                                    <option value="ลาดบัวขาว รถบัส">ลาดบัวขาว รถบัส</option>
                                    <option value="ดงน้อย">ดงน้อย</option>
                                    <option value="สนามชัย">สนามชัย</option>
                                    <option value="กรุงเทพ">กรุงเทพ</option>
                                    <option value="บางน้ำเปรี้ยว">บางน้ำเปรี้ยว</option>
                                    <option value="อื่นๆ">อื่นๆ</option>
                                </select>
                            </div>
                            <div class="row" id="edit-other-route-row" style="display: none;">
                                <label for="editotherroute">-</label>
                                <input type="text" id="editotherroute" name="editotherroute" style="width: 43%;">
                            </div>
                            <div class="row">
                                <label for="bus_number">คันที่:</label>
                                <input type="number" id="bus_number" name="bus_number" style="width: 43%;">
                            </div>
                            <div class="row">
                                <label for="seat_number">ที่นั่ง:</label>
                                <input type="number" id="seat_number" name="seat_number" style="width: 43%;">
                            </div>
                            <button type="submit">Submit</button>
                        </form>
                    </div>
                </div>

            </section>
        </main>
    </div>
    <script src="/js/seattoday.js"></script>
    <script src="/js/table-tools.js"></script>
</body>

</html>