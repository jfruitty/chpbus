<%
  // Shared admin sidebar menu — included by every admin page (and the chp2
  // rules shell) so the nav is identical everywhere. Items are organised into
  // collapsible groups; the group holding the current page is the only one
  // expanded on load. Active state comes from res.locals.currentPath (set by a
  // middleware in index.js); /chp2/rules matches by prefix so its sub-pages
  // keep the item highlighted. Self-contained styling (unique .adminmenu*
  // classes) so it looks the same regardless of which page CSS is loaded.
  //
  // Per-item 3rd element: optional 'admin'/'driver' restricts visibility.
  // Items with no role flag are visible to both roles. Empty groups (after
  // filtering) are hidden entirely so a driver session sees a slimmer sidebar.
  var _p = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '';
  var _role = (typeof userRole !== 'undefined' && userRole) ? userRole : 'admin';
  function _isActive(href) { return _p === href || _p.indexOf(href + '/') === 0; }
  function _allowed(it) { return !it[2] || it[2] === _role; }
  var _groups = [
    { title: 'สมาชิก & การจอง', items: [
      ['/member', 'Member', 'admin'], ['/thisweekdashboard', 'Thisweek', 'admin'],
      ['/nextweekdashboard', 'Nextweek', 'admin'],
      ['/sumthisweek', 'Sum (สัปดาห์นี้)', 'admin'], ['/sumnextweek', 'Sum (สัปดาห์หน้า)', 'admin'] ] },
    { title: 'จัดรถ', items: [
      ['/driver', 'Driver (เสนอ)'], ['/seatdriver', 'Seat (เสนอ)'],
      ['/bustoday', 'Bus (วันนี้)', 'admin'], ['/seattoday', 'Seat (วันนี้)', 'admin'] ] },
    { title: 'ผล HR & ประวัติ', items: [
      ['/busfromhr', 'BusfromHr'], ['/seatfromhr', 'SeatfromHr'],
      ['/bushistory', 'Bus History', 'admin'], ['/seathistory', 'Seat History', 'admin'] ] },
    { title: 'ระบบ', items: [
      ['/chp2/rules', 'เงื่อนไขจัดรถ (RMT)', 'admin'],
      ['/chp2/rules/routes', 'จัดการสายและจุด', 'admin'],
      ['/holiday', 'วันหยุด', 'admin'],
      ['/changelog', 'Log'] ] },
  ];
  // Filter items by current role, then drop any group left empty.
  _groups = _groups.map(function (g) { return { title: g.title, items: g.items.filter(_allowed) }; })
                   .filter(function (g) { return g.items.length > 0; });
  // Pick the single most-specific item to highlight (longest href that matches).
  // Without this, /chp2/rules and /chp2/rules/routes would both light up while
  // viewing the latter — looks like two active items.
  var _bestHref = '';
  _groups.forEach(function (g) { g.items.forEach(function (it) {
    if (_isActive(it[0]) && it[0].length > _bestHref.length) _bestHref = it[0];
  }); });
  function _isItemActive(href) { return href === _bestHref; }
  var _openIdx = -1;
  _groups.forEach(function (g, i) { if (g.items.some(function (it) { return _isItemActive(it[0]); })) _openIdx = i; });
  if (_openIdx === -1) _openIdx = 0;
%>
<style>
  .adminmenu { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .adminmenu .grp-title {
    width: 100%; text-align: left; background: none; border: none; cursor: pointer;
    font-family: inherit; font-size: 11px; font-weight: 800; letter-spacing: .4px;
    text-transform: uppercase; color: #94a3b8; padding: 12px 14px 6px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .adminmenu .grp-title:hover { color: #64748b; }
  .adminmenu .grp-title .caret { font-size: 9px; transition: transform .15s ease; }
  .adminmenu .grp.collapsed .grp-title .caret { transform: rotate(-90deg); }
  .adminmenu .grp-items { list-style: none; margin: 0 0 4px; padding: 0; }
  .adminmenu .grp.collapsed .grp-items { display: none; }
  .adminmenu .grp-items a {
    display: block; text-decoration: none; color: #475569; font-weight: 600;
    font-size: 14px; padding: 9px 14px 9px 24px; border-radius: 9px;
    transition: background .15s ease, color .15s ease;
  }
  .adminmenu .grp-items a:hover { background: #f1f5f9; }
  .adminmenu .grp-items a.active { background: #4a8cf7; color: #fff; box-shadow: 0 4px 12px rgba(74,140,247,.35); }
</style>
<nav class="adminmenu">
  <% _groups.forEach(function (g, i) { %>
  <div class="grp<%= i === _openIdx ? '' : ' collapsed' %>">
    <button type="button" class="grp-title"><%= g.title %> <span class="caret">▾</span></button>
    <ul class="grp-items">
      <% g.items.forEach(function (it) { %>
      <li><a href="<%= it[0] %>"<%- _isItemActive(it[0]) ? ' class="active"' : '' %>><%= it[1] %></a></li>
      <% }); %>
    </ul>
  </div>
  <% }); %>
</nav>
<script>
  (function () {
    document.querySelectorAll('.adminmenu .grp-title').forEach(function (btn) {
      btn.addEventListener('click', function () { btn.closest('.grp').classList.toggle('collapsed'); });
    });
  })();
</script>
