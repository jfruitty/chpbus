<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ประวัติการจัดรถ</title>
    <link href="/css/driver.css" rel="stylesheet" type="text/css">
    <style>
        .rh-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
        .rh-toolbar label { font-weight: 600; color: #475569; }
        .rh-toolbar select { padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; min-width: 220px; }
        .rh-empty { padding: 32px; text-align: center; color: #64748b; }
        .rh-block-title { font-size: 16px; font-weight: 800; color: #1e293b; margin: 18px 0 8px; }
        .rh-count { font-weight: 600; color: #64748b; font-size: 13px; }
        .rh-sub { color: #64748b; font-size: 12px; }
    </style>
</head>

<body>
    <div class="container">
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="logo"></div>
                <%- include('partials/adminmenu') %>
            </div>
            <div class="footer">
                <div class="company-info">
                    <p>Resonac</p>
                    <p>CHP</p>
                </div>
                <a href="/logout" style="display:block;margin-top:12px;padding:8px 12px;background:#ef4444;color:#fff;text-decoration:none;border-radius:6px;font-size:13px;text-align:center;">ออกจากระบบ</a>
            </div>
        </nav>
        <main class="main-content">
            <header class="header">
                <div class="user-info">
                    <span>ประวัติการจัดรถ (ย้อนหลังทุกวัน)</span>
                </div>
                <div class="actions"></div>
            </header>

            <section class="filter-bar" style="display:block;">
                <% if (dates.length === 0) { %>
                    <div class="rh-empty">
                        ยังไม่มีประวัติที่บันทึกไว้<br>
                        <span class="rh-sub">ประวัติจะเริ่มสะสมตั้งแต่ครั้งถัดไปที่ HR กดส่งให้คนขับ</span>
                    </div>
                <% } else { %>
                    <form method="get" action="/runhistory" class="rh-toolbar">
                        <label for="rh-date">เลือกวันที่จัดรถ:</label>
                        <select id="rh-date" name="date" onchange="this.form.submit()">
                            <% dates.forEach(function (d) { %>
                                <option value="<%= d %>" <%- d === selected ? 'selected' : '' %>><%= d %></option>
                            <% }); %>
                        </select>
                        <span class="rh-sub">มีประวัติ <%= dates.length %> วัน</span>
                    </form>
                <% } %>
            </section>

            <% if (selected) { %>
            <section class="table-section">
                <div class="rh-block-title">🚌 รถ / คนขับ <span class="rh-count">(<%= busRows.length %> คัน)</span></div>
                <table class="approval-table">
                    <thead>
                        <tr>
                            <th>ลำดับ</th>
                            <th>ทะเบียนรถ</th>
                            <th>ชื่อ สกุล (คนขับ)</th>
                            <th>สายรถ</th>
                            <th>วัน</th>
                            <th>ขา</th>
                            <th>เวลา</th>
                            <th>คันที่</th>
                            <th>ส่งเมื่อ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% busRows.forEach(function (row, i) { %>
                            <tr>
                                <td><%= i + 1 %></td>
                                <td><%= row.per_id %></td>
                                <td><%= row.first_name %> <%= row.last_name %></td>
                                <td><%= row.route %></td>
                                <td><%= row.day %></td>
                                <td><%= row.bound %></td>
                                <td><%= row.time %></td>
                                <td><%= row.bus_number %></td>
                                <td class="rh-sub"><%= row.sent_at %></td>
                            </tr>
                        <% }); %>
                        <% if (busRows.length === 0) { %>
                            <tr><td colspan="9" class="rh-empty">ไม่มีข้อมูลรถสำหรับวันนี้</td></tr>
                        <% } %>
                    </tbody>
                </table>

                <div class="rh-block-title">🧍 ผู้โดยสาร <span class="rh-count">(<%= seatRows.length %> คน)</span></div>
                <table class="approval-table">
                    <thead>
                        <tr>
                            <th>ลำดับ</th>
                            <th>รหัส</th>
                            <th>ชื่อ สกุล</th>
                            <th>สายรถ</th>
                            <th>จุดขึ้น</th>
                            <th>วัน</th>
                            <th>ขา</th>
                            <th>เวลา</th>
                            <th>คันที่</th>
                            <th>ที่นั่ง</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% seatRows.forEach(function (row, i) { %>
                            <tr>
                                <td><%= i + 1 %></td>
                                <td><%= row.perid %></td>
                                <td><%= row.first_name %> <%= row.last_name %></td>
                                <td><%= row.route %></td>
                                <td><%= row.location %></td>
                                <td><%= row.day %></td>
                                <td><%= row.bound %></td>
                                <td><%= row.time %></td>
                                <td><%= row.busnumber %></td>
                                <td><%= row.seat %></td>
                            </tr>
                        <% }); %>
                        <% if (seatRows.length === 0) { %>
                            <tr><td colspan="10" class="rh-empty">ไม่มีข้อมูลผู้โดยสารสำหรับวันนี้</td></tr>
                        <% } %>
                    </tbody>
                </table>

                <div class="footer-table">
                    <div></div>
                    <div class="results">
                        <span>รถ <%= busRows.length %> คัน / ผู้โดยสาร <%= seatRows.length %> คน</span>
                    </div>
                </div>
            </section>
            <% } %>
        </main>
    </div>
</body>

</html>
