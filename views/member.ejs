<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Member</title>
  <link href="/css/thisweekdashboard.css" rel="stylesheet" type="text/css">
  <link href="/css/member.css" rel="stylesheet" type="text/css">
</head>

<body>
  <div class="container">
    <nav class="sidebar">
      <div class="sidebar-header">
        <div class="logo">
          <!--<img src="/path/to/logo.png" alt="Company Logo"> -->
        </div>
        <ul class="menu">
          <li class="active"><a href="/member">Member</a></li>
          <li><a href="/thisweekdashboard">Thisweek</a></li>
          <li><a href="/nextweekdashboard">Nextweek</a></li>
          <li><a href="/sumthisweek">Sumthisweek</a></li>
          <li><a href="/bustoday">Bus</a></li>
          <li><a href="/seattoday">Seat</a></li>
          <li><a href="/bushistory">Bus History</a></li>
          <li><a href="/seathistory">Seat History</a></li>
        </ul>
      </div>
      <div class="footer">
        <div class="company-info">
          <p>Resonac</p>
          <p>CHP</p>
        </div>
        <a href="/logout" style="display:block;margin-top:12px;padding:8px 12px;background:#ef4444;color:#fff;text-decoration:none;border-radius:6px;font-size:13px;text-align:center;">ออกจากระบบ</a>
      </div>
    </nav>
    <main class="main-content">
      <header class="header">
        <div class="user-info">
          <h1 class="page-title">จัดการสมาชิก</h1>
          <p class="page-subtitle">อนุมัติและจัดการข้อมูลพนักงาน</p>
        </div>
        <div class="actions">
          <span class="member-count"><%= rows.length %> รายชื่อ</span>
        </div>
      </header>
      <section class="filter-bar">
        <div class="filter-field">
          <label>เลขประจำตัว</label>
          <input type="text" placeholder="เลขประจำตัว">
        </div>
        <div class="filter-field">
          <label>ชื่อ / นามสกุล</label>
          <input type="text" placeholder="ชื่อ">
        </div>
        <div class="filter-field">
          <label>แผนก</label>
          <select class="select-department">
            <option value="">ทุกแผนก</option>
            <% (departments || []).forEach(function (d) { %>
              <option value="<%= d %>"><%= d %></option>
            <% }) %>
          </select>
        </div>
        <button class="apply-btn">ค้นหา</button>
      </section>
      <section class="table-section">
        <table class="approval-table">
          <thead>
            <tr>
              <th>ลำดับ</th>
              <th>หมายเลขประจำตัว</th>
              <th>ชื่อใน Line</th>
              <th>ชื่อ</th>
              <th>นามสกุล</th>
              <th>แผนก</th>
              <th>จุดขึ้นรถ</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach((row, index)=> { %>
              <tr data-userid="<%= row.userid %>">
                <td>
                  <%= index + 1 %>
                </td>
                <td>
                  <%= row.perid %>
                </td>
                <td>
                  <%= row.displayname %>
              </td>
                <td>
                  <%= row.first_name %>
                </td>
                <td>
                  <%= row.last_name %>
                </td>
                <td>
                  <select class="user-department">
                    <% if (!row.department) { %>
                      <option value="" selected hidden>- ไม่ระบุ -</option>
                    <% } else if (!(departments || []).includes(row.department)) { %>
                      <option value="<%= row.department %>" selected hidden><%= row.department %></option>
                    <% } %>
                    <% (departments || []).forEach(function(d){ %>
                      <option value="<%= d %>" <%= row.department===d ? 'selected' : '' %>><%= d %></option>
                    <% }) %>
                  </select>
                </td>
                <td>
                  <select class="user-location">
                    <option value="">- ไม่ระบุ -</option>
                    <% let _lastRoute = null; %>
                    <% (stops || []).forEach(function (s) { %>
                      <% if (s.route_code !== _lastRoute) { %>
                        <% if (_lastRoute !== null) { %></optgroup><% } %>
                        <optgroup label="<%= s.route_code %> — <%= s.route_name %>">
                        <% _lastRoute = s.route_code; %>
                      <% } %>
                      <option value="<%= s.id %>" <%= String(row.home_stop_id) === String(s.id) ? 'selected' : '' %>><%= s.label %></option>
                    <% }) %>
                    <% if (_lastRoute !== null) { %></optgroup><% } %>
                  </select>
                </td>
                <td>
                  <select class="approval-status <%= row.approvalstatus %>">
                    <option value="approved" class="approval-status approved" <%=row.approvalstatus==='approved'
                      ? 'selected' : '' %>>✓ Approve</option>
                    <option value="pending" class="approval-status pending" <%=row.approvalstatus==='pending'
                      ? 'selected' : '' %>>⏲ Pending</option>
                    <option value="reject" class="approval-status reject" <%=row.approvalstatus==='reject' ? 'selected'
                      : '' %>>⨂ Reject</option>
                  </select>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
        <div class="footer-table">
          <div class="pagination">
            <button class="prev-page">&lt;</button>
            <span>1/10 Pages</span>
            <button class="next-page">&gt;</button>
          </div>
          <div class="results">
            <span>1 result(s)</span>
          </div>

        </div>

      </section>
    </main>
  </div>
  <script src="/js/member.js"></script>
  <script src="/js/table-tools.js"></script>
</body>

</html>
