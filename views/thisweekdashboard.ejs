<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>This week Summary</title>
    <link href="/css/thisweekdashboard.css" rel="stylesheet" type="text/css">
</head>

<body>
    <div class="container">
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <!--<img src="/path/to/logo.png" alt="Company Logo"> -->
                </div>
                <%- include('partials/adminmenu') %>
            </div>
            <div class="footer">
                <div class="company-info">
                    <p>Resonac</p>
                    <p>CHP</p>
                </div>
                <a href="/logout" style="display:block;margin-top:12px;padding:8px 12px;background:#ef4444;color:#fff;text-decoration:none;border-radius:6px;font-size:13px;text-align:center;">ออกจากระบบ</a>
            </div>
        </nav>
        <main class="main-content">
            <header class="header">
                <div class="user-info">
                    <!-- <img src="/path/to/user-avatar.png" alt="User Avatar"> -->
                    <span>CHP Shuttle Bus</span>
                </div>
                <div class="actions">
                </div>
            </header>
            <section class="filter-bar">
                <input type="text" placeholder="สายรถ" data-filter="route">
                <input type="text" placeholder="วัน" data-filter="day">
                <input type="text" placeholder="ขา" data-filter="bound">
                <input type="text" placeholder="เวลา" data-filter="time">
            </section>
            <section class="table-section">
                <table class="approval-table">
                    <thead>
                        <tr>
                            <th>ลำดับ</th>
                            <th>หมายเลขประจำตัว</th>
                            <th>ชื่อ</th>
                            <th>นามสกุล</th>
                            <th>จุดขึ้นรถ</th>
                            <th>แผนก</th>
                            <th data-day="จันทร์" data-bound="ขาเข้า">🟡 เข้า</th>
                            <th data-day="จันทร์" data-bound="ขาออก">🟡 ออก</th>
                            <th data-day="อังคาร" data-bound="ขาเข้า">🌸 เข้า</th>
                            <th data-day="อังคาร" data-bound="ขาออก">🌸 ออก</th>
                            <th data-day="พุธ" data-bound="ขาเข้า">🟢 เข้า</th>
                            <th data-day="พุธ" data-bound="ขาออก">🟢 ออก</th>
                            <th data-day="พฤหัสบดี" data-bound="ขาเข้า">🟠 เข้า</th>
                            <th data-day="พฤหัสบดี" data-bound="ขาออก">🟠 ออก</th>
                            <th data-day="ศุกร์" data-bound="ขาเข้า">🔵 เข้า</th>
                            <th data-day="ศุกร์" data-bound="ขาออก">🔵 ออก</th>
                            <th data-day="เสาร์" data-bound="ขาเข้า">🟣 เข้า</th>
                            <th data-day="เสาร์" data-bound="ขาออก">🟣 ออก</th>
                            <th data-day="อาทิตย์" data-bound="ขาเข้า">🔴 เข้า</th>
                            <th data-day="อาทิตย์" data-bound="ขาออก">🔴 ออก</th>
                            <th>อนุมัติแผนก</th>

                        </tr>
                    </thead>
                    <tbody>
                        <% rows.forEach((row, index)=> { %>
                            <tr data-userid="<%= row.userid %>" data-department="<%= row.department || '' %>" data-route="<%= row.route || '' %>">
                                <td>
                                    <%= index + 1 %>
                                </td>
                                <td>
                                    <%= row.perid %>
                                </td>
                                <td>
                                    <%= row.first_name %>
                                </td>
                                <td>
                                    <%= row.last_name %>
                                </td>
                                <td>
                                    <%= row.location %>
                                </td>
                                <td class="dept-cell">
                                    <%= row.department %>
                                </td>
                                <td>
                                    <% if (row.monday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.monday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.monday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.monday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.tuesday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.tuesday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.tuesday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.tuesday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.wednesday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.wednesday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.wednesday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.wednesday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.thursday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.thursday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.thursday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.thursday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.friday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.friday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.friday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.friday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.saturday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.saturday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.saturday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.saturday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.sunday_inbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.sunday_inbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <% if (row.sunday_outbound==='ไม่ใช้' ) { %>
                                        &#10060;
                                        <% } else { %>
                                            <%= row.sunday_outbound %>
                                                <% } %>
                                </td>
                                <td>
                                    <select class="approval-department-thisweek <%= row.department_approval %>">
                                        <option value="approved" class="approval-department-thisweek approved"
                                            <%=row.department_approval==='approved' ? 'selected' : '' %>>✓ Approve
                                        </option>
                                        <option value="pending" class="approval-department-thisweek pending"
                                            <%=row.department_approval==='pending' ? 'selected' : '' %>>⏲ Pending
                                        </option>
                                        <option value="reject" class="approval-department-thisweek reject"
                                            <%=row.department_approval==='reject' ? 'selected' : '' %>>⨂ Reject</option>
                                    </select>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </section>
        </main>
    </div>
    <script src="/js/dashboard.js"></script>
    <script src="/js/table-tools.js"></script>
</body>

</html>